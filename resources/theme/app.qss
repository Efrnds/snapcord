/* Snapcord theme template — tokens are substituted by Theme at runtime. */

QWidget {
    color: @text;
    font-size: @fontSize;
}

QMainWindow, #chatArea {
    background: @bg2;
}

QToolTip {
    background: @bg4;
    color: @text;
    border: none;
    padding: 6px 8px;
}

QMenu {
    background: @bg4;
    border: 1px solid @surface;
    padding: 6px;
}
QMenu::item {
    color: @textDim;
    padding: 6px 24px 6px 8px;
    border-radius: 2px;
}
QMenu::item:selected {
    background: @accent;
    color: @onAccent;
}

/* Thin scroll bars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @bg0;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Server rail */
#serverRail, #serverRailContent, #serverRail QScrollArea {
    background: @bg0;
}
#railSeparator {
    background: @hover;
    border-radius: 1px;
}

/* Channel sidebar */
#channelSidebar {
    background: @bg1;
}
#sidebarHeader {
    border-bottom: 1px solid @border;
}
#sidebarHeader QLabel {
    color: @textBright;
    font-size: @fontSizeMd;
    font-weight: 600;
}
#channelTree {
    background: transparent;
    border: none;
    outline: 0;
    padding-top: 8px;
}
#channelTree::item, #channelTree::item:hover, #channelTree::item:selected {
    background: transparent;
}
#channelTree::branch {
    background: transparent;
    image: none;
}

/* Voice connection panel */
#voicePanel {
    background: @bg3;
    border-bottom: 1px solid @border;
}
#voiceStatus {
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    color: @warning;
    font-size: @fontSize;
    font-weight: 700;
}
#voiceStatus[connected="true"] {
    color: @success;
}
#voiceStatus:hover {
    text-decoration: underline;
}

/* Connection info popup */
#connectionInfo {
    background: @bg4;
    border: 1px solid @bg1;
    border-radius: 6px;
}
#connectionInfo QLabel {
    color: @textDim;
    font-size: @fontSizeHint;
}
#connectionInfoTitle {
    color: @textBright;
    font-size: @fontSizeMd;
    font-weight: 700;
}

/* Incoming call */
#incomingCall {
    background: @bg3;
    border: 1px solid @surface;
    border-radius: 8px;
}
#incomingCallName {
    color: @textBright;
    font-size: @fontSizeXl;
    font-weight: 700;
}
#incomingCallStatus {
    color: @textDim;
    font-size: @fontSize;
}
#acceptCallButton {
    background: @success;
    border: none;
    border-radius: 28px;
}
#acceptCallButton:hover {
    background: @successHover;
}
#declineCallButton {
    background: @danger;
    border: none;
    border-radius: 28px;
}
#declineCallButton:hover {
    background: @dangerHover;
}

QCheckBox {
    color: @text;
    spacing: 10px;
    font-size: @fontSize;
}
#voiceLocation {
    color: @textMuted;
    font-size: @fontSizeSm;
}
#voicePanel QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}
#voicePanel QToolButton:hover {
    background: @hover;
}

/* User panel — profilePrimary / profileAccent are local Nitro-style colors */
#userPanel {
    background: @profilePrimary;
    border-left: 3px solid @profileAccent;
}
#userName {
    color: @textBright;
    font-size: @fontSize;
    font-weight: 600;
}
#userStatus {
    color: @textMuted;
    font-size: @fontSizeSm;
}
#userPanel QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}
#userPanel QToolButton:hover {
    background: @hover;
}

/* Chat area */
#chatHeader {
    border-bottom: 1px solid @border;
}
#chatTitle {
    color: @textBright;
    font-size: @fontSizeLg;
    font-weight: 600;
}
#welcomeTitle {
    color: @textBright;
    font-size: @fontSizeDisplay;
    font-weight: 700;
}
#welcomeSubtitle {
    color: @textDim;
    font-size: @fontSizeMd;
}

/* Chat */
#messageList {
    background: @bg2;
    border: none;
}
#chatTopic {
    color: @textMuted;
    font-size: @fontSize;
    padding-left: 8px;
    border-left: 1px solid @hover;
    margin-left: 4px;
}
#headerCallButton {
    background: transparent;
    color: @text;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: @fontSize;
}
#headerCallButton:hover {
    background: @hover;
}
#composerBox {
    background: @selected;
    border-radius: 8px;
}
#composer {
    background: transparent;
    border: none;
    color: @text;
    font-size: @fontSizeMd;
    selection-background-color: @accent;
}
#composerModeBar {
    background: @bg1;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
#composerModeLabel {
    color: @textDim;
    font-size: @fontSizeHint;
}
#composerModeCancel, #emojiButton {
    background: transparent;
    border: none;
    color: @textDim;
    font-size: @fontSizeXl;
    padding: 6px;
}
#composerModeCancel:hover, #emojiButton:hover {
    color: @textBright;
}
#typingLabel {
    color: @text;
    font-size: @fontSizeSm;
    padding-left: 4px;
}
#emojiPicker {
    background: @bg1;
    border: 1px solid @surface;
    border-radius: 8px;
}
#emojiSearch {
    background: @surface;
    color: @text;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
}
#emojiGrid {
    background: transparent;
    border: none;
    outline: 0;
}
#emojiGrid::item:hover {
    background: @selected;
    border-radius: 4px;
}

/* Voice channel view */
#voiceChannelView {
    background: @bg0;
}
#voiceChannelView #chatHeader {
    background: @bg2;
}
#voiceChannelView #welcomeSubtitle {
    color: @textDim;
}

/* Buttons */
#joinVoiceButton, #primaryButton {
    background: @success;
    color: @onAccent;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: @fontSize;
    font-weight: 600;
}
#joinVoiceButton:hover, #primaryButton:hover {
    background: @successHover;
}
#joinVoiceButton:disabled {
    background: @button;
    color: @textMuted;
}
#secondaryButton {
    background: @button;
    color: @textBright;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: @fontSize;
}
#secondaryButton:hover {
    background: @buttonHover;
}
#dangerButton {
    background: transparent;
    color: @danger;
    border: none;
    border-radius: 4px;
    padding: 8px;
    text-align: left;
    font-size: @fontSizeMd;
}
#dangerButton:hover {
    background: @hover;
}

#brandButton {
    background: @accent;
    color: @onAccent;
    border: none;
    border-radius: 4px;
    padding: 10px 16px;
    font-size: @fontSizeMd;
    font-weight: 600;
}
#brandButton:hover {
    background: @accentHover;
}
#brandButton:disabled {
    background: @accentMuted;
    color: @textDim;
}
#linkButton {
    background: transparent;
    color: @link;
    border: none;
    padding: 0;
    font-size: @fontSize;
    text-align: left;
}
#linkButton:hover {
    text-decoration: underline;
}

/* Login */
#tokenInput {
    background: @surface;
    color: @text;
    border: none;
    border-radius: 4px;
    padding: 10px;
    font-size: @fontSizeMd;
}
#tokenError {
    color: @danger;
    font-size: @fontSizeHint;
}
#loginWindow {
    background: @surface;
}
#loginCard {
    background: @bg2;
    border-radius: 8px;
}
#loginTitle {
    color: @textBright;
    font-size: @fontSizeHero;
    font-weight: 600;
}
#loginSubtitle {
    color: @textDim;
    font-size: @fontSizeLg;
}
#loginSteps {
    color: @text;
    font-size: @fontSizeMd;
}
#loginWarning {
    color: @textMuted;
    font-size: @fontSizeSm;
}
#qrTitle {
    color: @textBright;
    font-size: @fontSizeHero;
    font-weight: 600;
}
#qrHint {
    color: @textDim;
    font-size: @fontSizeMd;
}

/* Settings */
#settingsSide {
    background: @bg1;
}
#settingsContent {
    background: @bg2;
}
#settingsNavigation {
    background: transparent;
    border: none;
    outline: 0;
}
#settingsNavigation::item {
    color: @textDim;
    padding: 6px 10px;
    border-radius: 4px;
    margin: 1px 0;
}
#settingsNavigation::item:hover {
    background: @hover;
    color: @text;
}
#settingsNavigation::item:selected {
    background: @selected;
    color: @textBright;
}
#settingsTitle {
    color: @textBright;
    font-size: @fontSizeTitle;
    font-weight: 600;
}
#settingsSection {
    color: @textDim;
    font-size: @fontSizeSm;
    font-weight: 700;
}
#settingsHint {
    color: @textMuted;
    font-size: @fontSizeHint;
}
#colorSwatch {
    /* Fill is painted by ColorSwatch; only keep the hit-target size here. */
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    padding: 0;
    border: none;
    background: transparent;
}
#colorSwatch:hover {
    background: transparent;
}
#presetCard {
    background: @bg1;
    border: 2px solid @border;
    border-radius: 8px;
    padding: 10px;
}
#presetCard[selected="true"] {
    border-color: @accent;
}
#presetCard:hover {
    border-color: @textMuted;
}

QComboBox {
    background: @surface;
    color: @text;
    border: none;
    border-radius: 4px;
    padding: 8px 10px;
    min-height: 20px;
}
QComboBox QAbstractItemView {
    background: @bg1;
    color: @text;
    border: 1px solid @surface;
    selection-background-color: @selected;
}
QRadioButton {
    color: @text;
    spacing: 10px;
    padding: 4px 0;
}
QSlider::groove:horizontal {
    height: 8px;
    background: @button;
    border-radius: 4px;
}
QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: @textBright;
    width: 10px;
    height: 24px;
    margin: -8px 0;
    border-radius: 3px;
}
QMessageBox {
    background: @bg2;
}
QMessageBox QPushButton {
    background: @accent;
    color: @onAccent;
    border: none;
    border-radius: 3px;
    padding: 6px 16px;
    min-width: 60px;
}
QMessageBox QPushButton:hover {
    background: @accentHover;
}
