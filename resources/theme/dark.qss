/* Snapcord dark theme — colors based on the Discord layout. */

QWidget {
    color: #dbdee1;
    font-size: 14px;
}

QMainWindow, #chatArea {
    background: #313338;
}

QToolTip {
    background: #111214;
    color: #dbdee1;
    border: none;
    padding: 6px 8px;
}

QMenu {
    background: #111214;
    border: 1px solid #1e1f22;
    padding: 6px;
}
QMenu::item {
    color: #b5bac1;
    padding: 6px 24px 6px 8px;
    border-radius: 2px;
}
QMenu::item:selected {
    background: #5865f2;
    color: #ffffff;
}

/* Thin scroll bars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1a1b1e;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Server rail */
#serverRail, #serverRailContent, #serverRail QScrollArea {
    background: #1e1f22;
}
#railSeparator {
    background: #35363c;
    border-radius: 1px;
}

/* Channel sidebar */
#channelSidebar {
    background: #2b2d31;
}
#sidebarHeader {
    border-bottom: 1px solid #1f2023;
}
#sidebarHeader QLabel {
    color: #f2f3f5;
    font-size: 15px;
    font-weight: 600;
}
#channelTree {
    background: transparent;
    border: none;
    outline: 0;
    padding-top: 8px;
}
/* Rows are painted by ChannelDelegate; keep the view itself from drawing row backgrounds. */
#channelTree::item, #channelTree::item:hover, #channelTree::item:selected {
    background: transparent;
}
#channelTree::branch {
    background: transparent;
    image: none;
}

/* Voice connection panel */
#voicePanel {
    background: #232428;
    border-bottom: 1px solid #2e2f34;
}
#voiceStatus {
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    color: #f0b232;
    font-size: 14px;
    font-weight: 700;
}
#voiceStatus[connected="true"] {
    color: #23a559;
}
#voiceStatus:hover {
    text-decoration: underline;
}

/* Connection info popup */
#connectionInfo {
    background: #111214;
    border: 1px solid #2b2d31;
    border-radius: 6px;
}
#connectionInfo QLabel {
    color: #b5bac1;
    font-size: 13px;
}
#connectionInfoTitle {
    color: #f2f3f5;
    font-size: 15px;
    font-weight: 700;
}

/* Incoming call */
#incomingCall {
    background: #232428;
    border: 1px solid #1e1f22;
    border-radius: 8px;
}
#incomingCallName {
    color: #f2f3f5;
    font-size: 18px;
    font-weight: 700;
}
#incomingCallStatus {
    color: #b5bac1;
    font-size: 14px;
}
#acceptCallButton {
    background: #248046;
    border: none;
    border-radius: 28px;
}
#acceptCallButton:hover {
    background: #1a6334;
}
#declineCallButton {
    background: #da373c;
    border: none;
    border-radius: 28px;
}
#declineCallButton:hover {
    background: #a12829;
}

QCheckBox {
    color: #dbdee1;
    spacing: 10px;
    font-size: 14px;
}
#voiceLocation {
    color: #949ba4;
    font-size: 12px;
}
#voicePanel QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}
#voicePanel QToolButton:hover {
    background: #3a3c41;
}

/* User panel */
#userPanel {
    background: #232428;
}
#userName {
    color: #f2f3f5;
    font-size: 14px;
    font-weight: 600;
}
#userStatus {
    color: #949ba4;
    font-size: 12px;
}
#userPanel QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}
#userPanel QToolButton:hover {
    background: #3a3c41;
}

/* Chat area */
#chatHeader {
    border-bottom: 1px solid #26272b;
}
#chatTitle {
    color: #f2f3f5;
    font-size: 16px;
    font-weight: 600;
}
#welcomeTitle {
    color: #f2f3f5;
    font-size: 28px;
    font-weight: 700;
}
#welcomeSubtitle {
    color: #b5bac1;
    font-size: 15px;
}

/* Voice channel view */
#voiceChannelView {
    background: #000000;
}
#voiceChannelView #chatHeader {
    background: #313338;
}
#voiceChannelView #welcomeSubtitle {
    color: #b5bac1;
}

/* Buttons */
#joinVoiceButton, #primaryButton {
    background: #248046;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: 600;
}
#joinVoiceButton:hover, #primaryButton:hover {
    background: #1a6334;
}
#joinVoiceButton:disabled {
    background: #4e5058;
    color: #949ba4;
}
#secondaryButton {
    background: #4e5058;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
}
#secondaryButton:hover {
    background: #6d6f78;
}
#dangerButton {
    background: transparent;
    color: #f23f43;
    border: none;
    border-radius: 4px;
    padding: 8px;
    text-align: left;
    font-size: 15px;
}
#dangerButton:hover {
    background: #35373c;
}

#brandButton {
    background: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 10px 16px;
    font-size: 15px;
    font-weight: 600;
}
#brandButton:hover {
    background: #4752c4;
}
#brandButton:disabled {
    background: #3c4270;
    color: #b5bac1;
}
#linkButton {
    background: transparent;
    color: #00a8fc;
    border: none;
    padding: 0;
    font-size: 14px;
    text-align: left;
}
#linkButton:hover {
    text-decoration: underline;
}

/* Login */
#tokenInput {
    background: #1e1f22;
    color: #dbdee1;
    border: none;
    border-radius: 4px;
    padding: 10px;
    font-size: 15px;
}
#tokenError {
    color: #fa777c;
    font-size: 13px;
}
#loginWindow {
    background: #1e1f22;
}
#loginCard {
    background: #313338;
    border-radius: 8px;
}
#loginTitle {
    color: #f2f3f5;
    font-size: 24px;
    font-weight: 600;
}
#loginSubtitle {
    color: #b5bac1;
    font-size: 16px;
}
#loginSteps {
    color: #dbdee1;
    font-size: 15px;
}
#loginWarning {
    color: #949ba4;
    font-size: 12px;
}
#qrTitle {
    color: #f2f3f5;
    font-size: 24px;
    font-weight: 600;
}
#qrHint {
    color: #b5bac1;
    font-size: 15px;
}

/* Settings */
#settingsSide {
    background: #2b2d31;
}
#settingsContent {
    background: #313338;
}
#settingsNavigation {
    background: transparent;
    border: none;
    outline: 0;
}
#settingsNavigation::item {
    color: #b5bac1;
    padding: 6px 10px;
    border-radius: 4px;
    margin: 1px 0;
}
#settingsNavigation::item:hover {
    background: #35373c;
    color: #dbdee1;
}
#settingsNavigation::item:selected {
    background: #404249;
    color: #ffffff;
}
#settingsTitle {
    color: #f2f3f5;
    font-size: 20px;
    font-weight: 600;
}
#settingsSection {
    color: #b5bac1;
    font-size: 12px;
    font-weight: 700;
}
#settingsHint {
    color: #949ba4;
    font-size: 13px;
}
QComboBox {
    background: #1e1f22;
    color: #dbdee1;
    border: none;
    border-radius: 4px;
    padding: 8px 10px;
    min-height: 20px;
}
QComboBox QAbstractItemView {
    background: #2b2d31;
    color: #dbdee1;
    border: 1px solid #1e1f22;
    selection-background-color: #404249;
}
QRadioButton {
    color: #dbdee1;
    spacing: 10px;
    padding: 4px 0;
}
QSlider::groove:horizontal {
    height: 8px;
    background: #4e5058;
    border-radius: 4px;
}
QSlider::sub-page:horizontal {
    background: #5865f2;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    width: 10px;
    height: 24px;
    margin: -8px 0;
    border-radius: 3px;
}
QMessageBox {
    background: #313338;
}
QMessageBox QPushButton {
    background: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    padding: 6px 16px;
    min-width: 60px;
}
QMessageBox QPushButton:hover {
    background: #4752c4;
}
